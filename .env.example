COMMENT_NOTIFY_EMAIL=

# Cloudflare KV namespace for auth sessions and magic link tokens.
# Create with: wrangler kv namespace create AUTH_KV
# Then update the id in wrangler.toml [[kv_namespaces]] section.
# AUTH_KV is bound via wrangler.toml, no env var needed at runtime.

# Google OAuth (https://console.cloud.google.com/)
# Authorized redirect URI: https://<your-domain>/api/auth/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# X (Twitter) OAuth 2.0 (https://developer.twitter.com/en/portal/dashboard)
# Authorized redirect URI: https://<your-domain>/api/auth/oauth/x/callback
# Required scopes: tweet.read users.read
X_CLIENT_ID=
X_CLIENT_SECRET=
